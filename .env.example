# Server Configuration
HTTP_ADDR=:8080
LOG_LEVEL=info

# Database Configuration (PostgreSQL + pgvector)
# Note: In Docker Compose, the API service uses postgres:5432. For local host commands (like go run or migrations), use localhost:5433.
DATABASE_URL=postgres://knowflow:knowflow@localhost:5433/knowflow?sslmode=disable

# CORS and Authentication
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:3000

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
LLM_MODEL=gemini-1.5-flash

# Ingestion and Chunking
MAX_UPLOAD_BYTES=1048576
CHUNK_TARGET_TOKENS=650
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_PCT=12

# Retrieval and RAG Pipeline
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.65
HISTORY_TURNS=6

# Async Processing and Workers
WORKER_COUNT=2
WORKER_POLL_INTERVAL=2s
JOB_MAX_ATTEMPTS=5
JOB_STALE_AFTER=10m
JOB_TIMEOUT=5m

# Rate Limiting and External Timeouts
AI_RATE_LIMIT_RPS=5
AI_CALL_TIMEOUT=30s

